# Copy to .env and fill in, then:  set -a; source .env; set +a
# Either set DATABASE_URL...
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nse
# ...or the individual libpq variables (DATABASE_URL takes precedence):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=nse
# PGUSER=shadab
# PGPASSWORD=
